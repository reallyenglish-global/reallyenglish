---
import CmsPage from '../components/CmsPage.astro';
import LeadForm from '../components/LeadForm.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {configuredBrand,loadHomePage,brandTheme} from '../lib/site';
import {loadCmsPage} from '../lib/content';
const host=Astro.request.headers.get('host') || '';
const brand=configuredBrand(host);
if (!brand) return new Response('Not found',{status:404});
const cms=brand.slug==='reallyenglish' && process.env.CMS_API_URL ? await loadCmsPage(host,'/') : null;
if (cms instanceof Response) return cms;
if (brand.slug==='reallyenglish' && process.env.CMS_API_URL && !cms) return new Response('Content unavailable',{status:503});
const demo=await loadHomePage(brand);
const theme=brandTheme(brand);
---
{cms ? <CmsPage page={cms} /> : <SiteLayout brand={brand} title={`${brand.name} | English learning for real life`} description={demo.body} primary={theme.primary} accent={theme.accent}>
<header><a href="/">{brand.logoText}</a></header><main><h1>{demo.title}</h1><p>{demo.body}</p>{demo.features.map(f=><section><h2>{f.title}</h2><p>{f.body}</p></section>)}<section id="contact"><LeadForm brandSlug={brand.slug} brandName={brand.name}/></section></main>
</SiteLayout>}