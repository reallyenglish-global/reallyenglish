---
import SiteLayout from '../layouts/SiteLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { brandTheme, loadBrand, loadHomePage, resolveBrand } from '../lib/site';
const host = Astro.request.headers.get('host') ?? 'localhost';
const requestedBrand = resolveBrand(host);
const brand = await loadBrand(requestedBrand);
const page = await loadHomePage(brand);
const theme = brandTheme(brand);
---
<SiteLayout brand={brand} title={`${brand.name} | English learning for real life`} description={page.body} primary={theme.primary} accent={theme.accent}>
  <header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-10">
    <a href="/" class="flex items-center gap-3 font-bold tracking-tight" aria-label={`${brand.name} home`}><span class="grid size-10 place-items-center rounded-xl bg-[var(--brand-primary)] text-sm text-white">{brand.shortName}</span><span class="text-lg">{brand.logoText}</span></a>
    <nav class="flex items-center gap-6 text-sm font-semibold text-slate-700"><a class="hidden hover:text-[var(--brand-primary)] sm:inline" href="#approach">Our approach</a><a href="#contact" class="rounded-full bg-[var(--brand-primary)] px-5 py-3 text-white hover:brightness-110">{page.ctaLabel}</a></nav>
  </header>
  <main>
    <section class="relative isolate overflow-hidden"><div class="absolute inset-0 -z-10 bg-[var(--brand-accent)] opacity-50"></div><div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 lg:grid-cols-[1.15fr_.85fr] lg:px-10 lg:py-28">
      <div><p class="mb-5 font-semibold uppercase tracking-[.18em] text-[var(--brand-primary)]">{page.eyebrow}</p><h1 class="max-w-3xl text-5xl font-semibold leading-[1.04] tracking-[-.045em] text-slate-950 sm:text-6xl lg:text-7xl">{page.title}</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-slate-700">{page.body}</p><a href={page.ctaHref} class="mt-9 inline-flex items-center gap-3 rounded-full bg-[var(--brand-primary)] px-7 py-4 font-semibold text-white shadow-lg shadow-emerald-950/10 hover:brightness-110">{page.ctaLabel}<span aria-hidden="true">→</span></a><p class="mt-5 text-xs text-slate-500">A prototype of a flexible, partner-ready website.</p></div>
      <div class="rounded-[2rem] border border-white/80 bg-white/80 p-6 shadow-2xl shadow-slate-900/10 backdrop-blur sm:p-9"><div class="mb-7 flex items-center justify-between"><div><p class="text-sm font-semibold text-[var(--brand-primary)]">Learning that moves with you</p><p class="mt-1 text-sm text-slate-500">Designed for people, ready for partners</p></div><span class="grid size-12 place-items-center rounded-2xl bg-[var(--brand-accent)] text-2xl" aria-hidden="true">✳</span></div><div class="space-y-4"><div class="rounded-2xl bg-slate-50 p-5"><div class="mb-3 flex justify-between text-xs font-semibold text-slate-600"><span>Learning journey</span><span>In progress</span></div><div class="h-2 overflow-hidden rounded-full bg-slate-200"><div class="h-full w-2/3 rounded-full bg-[var(--brand-primary)]"></div></div><div class="mt-4 flex gap-2"><span class="rounded-full bg-white px-3 py-1 text-xs text-slate-600">Practice</span><span class="rounded-full bg-white px-3 py-1 text-xs text-slate-600">Feedback</span><span class="rounded-full bg-white px-3 py-1 text-xs text-slate-600">Progress</span></div></div><div class="grid grid-cols-2 gap-4"><div class="rounded-2xl bg-[#f5f2eb] p-4"><p class="text-xs text-slate-500">Built for your goals</p><p class="mt-2 font-semibold">Learning with purpose</p></div><div class="rounded-2xl bg-[var(--brand-accent)] p-4"><p class="text-xs text-slate-600">Made to fit</p><p class="mt-2 font-semibold">Your brand, your way</p></div></div></div></div>
    </div></section>
    <section id="approach" class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28"><div class="max-w-2xl"><p class="font-semibold uppercase tracking-[.18em] text-[var(--brand-primary)]">A better way to learn</p><h2 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950">Learning experiences built around people.</h2></div><div class="mt-12 grid gap-5 md:grid-cols-3">{page.features.map((feature, index) => <article class="rounded-3xl border border-slate-200 bg-white p-7"><span class="grid size-11 place-items-center rounded-xl bg-[var(--brand-accent)] font-semibold text-[var(--brand-primary)]">0{index + 1}</span><h3 class="mt-6 text-xl font-semibold">{feature.title}</h3><p class="mt-3 leading-7 text-slate-600">{feature.body}</p></article>)}</div></section>
    <section class="bg-slate-950 text-white"><div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-2 lg:px-10 lg:py-24"><div><p class="font-semibold uppercase tracking-[.18em] text-emerald-300">Built with partners</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">A shared platform. Your brand in front.</h2><p class="mt-5 max-w-xl leading-7 text-slate-300">This prototype demonstrates separate partner branding and content selected by domain, while keeping the same component system and publishing workflow.</p><div class="mt-8 flex flex-wrap gap-3"><a href="http://partner.localhost:4321" class="rounded-full border border-slate-600 px-5 py-3 text-sm font-semibold hover:bg-slate-800">Preview partner brand</a><span class="rounded-full bg-slate-800 px-5 py-3 text-sm text-slate-300">Powered by {brand.name}</span></div></div><div id="contact" class="rounded-3xl bg-white p-7 text-slate-900 sm:p-9"><p class="text-sm font-semibold text-[var(--brand-primary)]">Start a conversation</p><h2 class="mt-2 text-2xl font-semibold">Tell us about your learners.</h2><p class="mb-6 mt-2 text-sm leading-6 text-slate-600">Server-side lead routing; demo mode discards submissions without sending or storing them.</p><LeadForm brandSlug={brand.slug} brandName={brand.name} /></div></div></section>
  </main>
  <footer class="bg-slate-950 px-6 pb-8 text-center text-xs text-slate-400">Prototype — content and brand styling are illustrative until approved by ReallyEnglish.</footer>
</SiteLayout>
