{
  "kind": "collectionType", "collectionName": "pages",
  "info": { "singularName": "page", "pluralName": "pages", "displayName": "Page", "description": "Reusable, brand-scoped marketing page content." },
  "options": { "draftAndPublish": true }, "pluginOptions": {},
  "attributes": {
    "externalKey": { "type": "string", "required": true, "unique": true },
    "path": { "type": "string", "required": true },
    "locale": { "type": "string", "required": true },
    "title": { "type": "string", "required": true },
    "description": { "type": "text" },
    "canonical": { "type": "string" },
    "alternates": { "type": "json" },
    "contentHtml": { "type": "text", "required": true },
    "sourceUrl": { "type": "string", "required": true },
    "sourceFetchedAt": { "type": "datetime", "required": true },
    "sourceRawHash": { "type": "string", "required": true },
    "contentHash": { "type": "string", "required": true },
    "assets": { "type": "json" },
    "slug": { "type": "string", "required": true },
    "eyebrow": { "type": "string" }, "heroTitle": { "type": "string" },
    "heroBody": { "type": "text" },
    "ctaLabel": { "type": "string", "default": "Talk to our team" },
    "ctaHref": { "type": "string", "default": "#contact" },
    "features": { "type": "json" },
    "brand": { "type": "relation", "relation": "manyToOne", "target": "api::brand.brand", "inversedBy": "pages", "required": true }
  }
}
